[Desktop Entry]
Version=1.0
Type=Application
Name=Regex Droid Studio
GenericName=Visual AST Regex Synthesizer & ReDoS Guard
Comment=Visual AST Regex Synthesizer, NFA/DFA Automaton Minimizer & ReDoS Vulnerability Guard
Exec=/usr/local/bin/regex-droid desktop
Icon=regex-droid
Terminal=false
Categories=Development;Security;System;Utility;
StartupNotify=true
Actions=CLI;Web;

[Desktop Action CLI]
Name=Open Regex Droid CLI
Exec=x-terminal-emulator -e "/usr/local/bin/regex-droid --help"

[Desktop Action Web]
Name=Open Web UI (Port 8101)
Exec=/usr/local/bin/regex-droid web
